# Required — free tier at console.groq.com
GROQ_API_KEY=

# Optional — additional keys enable round-robin rotation across daily
# per-key token quotas (generation/gateway.py). Add as many as you have.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Required for the Hugging Face fallback path (used when every Groq key
# is proactively-or-actually exhausted) — huggingface.co/settings/tokens
HF_TOKEN=

# Optional — enables Langfuse tracing for ask_langchain_hybrid.py. Fully
# inert with zero behavior change if unset. Free account at
# cloud.langfuse.com, or self-host.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
