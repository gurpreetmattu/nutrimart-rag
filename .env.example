# Required — free tier at console.groq.com
GROQ_API_KEY=

# Optional — additional keys enable round-robin rotation across daily
# per-key token quotas (generation/gateway.py). Add as many as you have.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Required for the Hugging Face fallback path (used when every Groq key
# is proactively-or-actually exhausted) — huggingface.co/settings/tokens
HF_TOKEN=

# Optional — enables Langfuse tracing for ask_langchain_hybrid.py. Fully
# inert with zero behavior change if unset. Free account at
# cloud.langfuse.com, or self-host.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# --- Qdrant ---
# Local dev (docker-compose up -d) needs neither of these — config.py
# defaults to localhost:6333. For a deployed environment (Cloud Run, Qdrant
# Cloud, any managed instance), set QDRANT_URL instead — a full https://...
# URL — plus QDRANT_API_KEY if the instance requires one. See README's
# Deploy section.
# QDRANT_URL=
# QDRANT_API_KEY=

# Only needed if you're overriding the local host/port defaults directly
# (rare — QDRANT_URL is what a deployed environment should use instead).
# QDRANT_HOST=
# QDRANT_PORT=

# Optional — where products.sqlite lives. Defaults to db/products.sqlite
# under the project root; override for a deployed environment with a
# persistent volume mounted somewhere else.
# DB_PATH=
